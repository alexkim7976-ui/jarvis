# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  JARVIS .env 템플릿
#  이 파일을 복사해 .env로 만들고 실제 키를 입력하세요.
#  cp .env.example .env && chmod 600 .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# LLM
LLM_PROVIDER=gemini
# 사용자 호칭 (음성·알림·LLM 프롬프트 공통, 기본: 김태현)
JARVIS_USER_NAME=김태현
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_here

# Gemini 하이브리드 모델 이원화
#  - FLASH: 음성 대화/명령 텍스트 분석 등 경량·고빈도 작업 (저비용·고속)
#  - PRO  : 차트 이미지 등 멀티모달 비전·복합 추론 (고정밀·고비용)
#  ※ 모델 ID는 현재 Gemini API에서 유효한지 반드시 확인 후 사용 (잘못되면 404)
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
# Gemini 호출당 전달할 최근 대화 메시지 수 (토큰 절약용 컨텍스트 윈도우, 기본 10)
GEMINI_CONTEXT_TURNS=10

# ── TTS(음성) ──
# 기본은 맥 내장 음성(Siri급, API 키 불필요). AVSpeechSynthesizer로 '품질이 가장 높은'
# 한국어 음성을 자동 선택한다.  ※ 로봇 같지 않게(=Siri처럼) 하려면 '향상된/프리미엄'
#   한국어 음성 설치가 핵심:  시스템 설정 → 손쉬운 사용 → 말하기 콘텐츠 → 시스템 음성
#   → 음성 관리… → 한국어(대한민국) → Yuna(향상된/프리미엄) 다운로드.
#   설치되면 재시작 없이 자동으로 그 음성을 사용한다.
# JARVIS_MAC_VOICE=Yuna       # 사용할 음성 이름(기본 Yuna=한국 Siri 음성). 예: Yuna / Suhyun
# JARVIS_TTS_RATE=auto        # AVSpeech 속도 0.0~1.0 (auto=가장 자연스러운 기본). 예: 0.5
# JARVIS_MAC_SAY_RATE=auto    # say 폴백 속도(wpm). auto=자연 기본. 예: 180
# JARVIS_TTS_USE_AV=1         # 0이면 AVSpeech 끄고 say만 사용
#
# (선택) Fish Audio — 유료 클라우드 TTS를 쓰고 싶을 때만. 무료 모드에선 무시됨.
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_VOICE_ID=your_voice_id_here

# 검색/날씨
TAVILY_API_KEY=your_tavily_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# ── CNN + Twitter 내일 주가 전망 (analyze_tomorrow_stock) ──
# CNN Money RSS / Google News(site:cnn.com) + Twitter/X 감성 → 다음 거래일 방향
# X API v2 Bearer(선택). 없으면 site:x.com 웹검색 폴백.
# X_BEARER_TOKEN=your_x_bearer_token_here
# TWITTER_BEARER_TOKEN=           # X_BEARER_TOKEN 별칭
# FORECAST_CNN_MAX=8
# FORECAST_TWITTER_MAX=12

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  주식 데이터 — 무료 API 다중 교차검증 (많이 넣을수록 정확도↑)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  analyze_stock_multi_source / analyze_stock_investment 이 아래 소스들을
#  병렬 조회 → 중앙값 기준 이상치 제외 후 합의값을 산출한다.
#  ▸ 키 불필요(자동 활성): Yahoo(yfinance), Stooq, 네이버 금융(한국)
#  ▸ 아래는 "무료 티어" 키 — 등록만 하면 무료. 넣을수록 교차검증 소스가 늘어난다.
#
# Finnhub — 무료 60req/분, 미국 위주 시세+PER/PBR/EPS.  https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here
# Alpha Vantage — 무료 25req/일(느림).  https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here
# Financial Modeling Prep — 무료 250req/일, 재무제표.  https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_key_here
# Open DART — 금감원 전자공시, 완전 무료.  https://opendart.fss.or.kr/  (한국 공시·재무)
DART_API_KEY=your_opendart_key_here
# 한국투자증권 OpenAPI — 계좌 있으면 무료 실시간 체결가.  https://apiportal.koreainvestment.com/
#   ※ 앱키/시크릿은 KIS 개발자센터의 '실전투자'와 '모의투자'가 서로 다름.
#     실전 키 → KIS_ENV=real, 모의 키 → KIS_ENV=virtual 로 반드시 맞춰야 함.
#     'EGW00103 유효하지 않은 AppKey' = 키 값 자체가 KIS에 등록되지 않음(재발급/재복사 필요).
#     'EGW00133' = 토큰 발급 1분 1회 제한(자동 캐시로 해소).
#   토큰은 ~/.jarvis/tokens 에 24h 캐시됨(JARVIS_TOKEN_DIR 로 변경 가능).
# KIS_APP_KEY=...
# KIS_APP_SECRET=...
# KIS_ACCOUNT_NO=...
# KIS_ENV=real            # real | virtual(모의)
# LS증권 / 키움증권 Open API (선택 — 계좌 있으면 무료)
# LS_APP_KEY=...     LS_APP_SECRET=...
# KIWOOM_APP_KEY=... KIWOOM_APP_SECRET=...  KIWOOM_ENV=real
#
# 참고: JARVIS_FREE_ONLY=1 이어도 위 소스는 전부 사용 가능(모두 무료).
#      키를 안 넣어도 Yahoo+Stooq+네이버(한국)만으로 교차검증이 동작한다.

# GitHub 모니터
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# ── 텔레그램 알림 브리지 ──
#  외출 중(얼굴 미검출 자동 AWAY) 긴급 뉴스·지정가·매크로 경보를 폰/아이패드로 푸시.
#  1) 텔레그램에서 @BotFather 검색 → /newbot → 봇 토큰(TELEGRAM_BOT_TOKEN) 발급
#  2) 만든 봇과 대화 시작(/start) 후, 아래 주소로 chat_id 확인:
#     https://api.telegram.org/bot<봇토큰>/getUpdates  → result[].message.chat.id
#  ※ 별도 패키지 불필요 — 내장 requests 로 Bot API 직접 호출.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# 테스트용: 1 로 두면 자리에 있어도(AWAY 아니어도) 항상 푸시 (검증 후 0 권장)
TELEGRAM_ALWAYS_PUSH=0

# Ollama 로컬 LLM (Apple Silicon: Ollama가 Metal GPU 자동 사용)
# 대화·도구호출 = 경량 tools 지원 모델. M시리즈 권장: qwen2.5:7b-instruct 또는 gemma4.
OLLAMA_MODEL=gemma4:latest
# ── 로컬 LLM 두뇌 (온디바이스 에이전트) ──
# 1=ON: 키워드 우회 없이 LLM function calling으로 모든 명령 해석 (볼륨·파일·주식·앱 등)
# 0=OFF: 주식 등 일부는 local_stock_router 키워드 fast-path 사용 (더 빠름)
# Ollama/무료 모드에서는 기본 1. 명시적으로 끄려면 JARVIS_LLM_BRAIN=0
# JARVIS_LLM_BRAIN=1
# JARVIS_ECOSYSTEM_ROUTER=1          # 주식·캘린더·SBU fast-path (기본 ON)
# JARVIS_MAC_CALENDAR=1            # macOS Calendar.app / Reminders (Google OAuth 대체)
CAMPUS_SCHEDULE_FILE=data/campus_schedule.json
# 스토니브룩 행정 메일 — 이 수신 주소로 온 메일만 감시·음성 안내
CAMPUS_GMAIL_ACCOUNT=taehyeon.kim.2@stonybrook.org
# 지정 발신자의 숙제·수업 관련 메일을 찾아 전화 알림
CAMPUS_COURSE_SENDER=taehyeon.kim.2@stonybrook.edu
# Twilio Voice 발신을 위해 계정 SID/토큰과 Voice 발신 가능 번호를 설정
CAMPUS_CALL_TO=+19342217610
CAMPUS_CALL_ALERTS=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1_your_twilio_number
# 주식·뉴스·멀티에이전트 추론 = NVIDIA Nemotron 3 Nano 30B (MoE 3.5B active, tools+thinking)
#   설치: ollama pull nemotron-3-nano:30b  (~24GB, 48GB RAM 권장)
#   미설치 시 대화 모델로 폴백하려면 아래 줄 주석 처리.
OLLAMA_STOCK_MODEL=nemotron-3-nano:30b
OLLAMA_URL=http://localhost:11434
# OLLAMA_THINK=0               # 추론 trace off(저지연). 깊은 추론 필요 시 1. (비추론 모델은 무시)
# OLLAMA_NUM_CTX=8192          # 컨텍스트 윈도우 상한 (토큰 누적 방지)
# OLLAMA_NUM_GPU=-1            # -1=Metal GPU 전 레이어 (기본), 0=CPU만

# Gemini Context Caching (입력 토큰 최대 ~80% 절감)
# GEMINI_CACHE_ENABLED=1              캐싱 ON (기본)
# GEMINI_CACHE_TTL_SEC=7200           TTL 2시간
# GEMINI_CACHE_REFRESH_BEFORE=600     만료 10분 전 자동 연장
# GEMINI_CACHE_CONTEXT_FILES=security.py,file_manager.py,stock_quant.py,...
# GEMINI_CACHE_MAX_FILE_KB=256        파일당 최대 KB
# GEMINI_CONTEXT_TURNS=10      # LLM 호출당 최근 N개 메시지만 전달
# JARVIS_MAX_HISTORY=40        # 메모리 유지 상한
# JARVIS_HISTORY_SUMMARIZE=1   # 오래된 대화 Gemini Flash로 압축 요약
# JARVIS_SUMMARIZE_CHARS=12000 # 이 문자 수 초과 시 요약 트리거

# JARVIS_SECURITY_LEVEL=standard|strict|maximum
#   standard — 기본 (개발·일상)
#   strict   — SSRF 엄격·감사 strict·FDS·이그레스 가드·속도 제한 강화
#   maximum  — strict + Keychain 전용·샌드박스 경로 강제·고위험 FDS 필수
# JARVIS_SECURITY_LEVEL=maximum

# ── 보안 세부 (미설정 시 JARVIS_SECURITY_LEVEL 에 따라 자동 적용) ──
# JARVIS_SSRF_STRICT=1              # DNS 실패 시 fail-closed (SSRF 차단)
# JARVIS_SSRF_DNS_CHECK=1
# JARVIS_AUDIT_ENFORCE=strict       # 감사 로그 변조 시 부팅 중단 (warn|strict)
# JARVIS_SANDBOX_ENFORCE=true       # 파일 작업 샌드박스 격리
# JARVIS_PATHS_SANDBOX_ONLY=1         # maximum: validate_path 도 샌드박스만 허용
# JARVIS_KEYCHAIN_ONLY=1            # maximum: API 키 Keychain 전용 (.env 평문 차단)
# JARVIS_NET_EGRESS_GUARD=1         # net.get/post 전 SSRF 검증
# JARVIS_FDS_TOOLS=1                # 고위험 도구 FDS 행동 탐지
# JARVIS_TOOL_RATE_MAX=12           # 분당 도구 호출 상한 (maximum 기본)
# JARVIS_DESTRUCTIVE_RATE_MAX=3     # 분당 파괴적 작업 상한 (maximum 기본)

# ── OpenClaw (AI 에이전트 게이트웨이) — CVE·Claw Chain 대응 ──
# OPENCLAW_ENABLED=1                # Jarvis ↔ OpenClaw 안전 프록시 ON
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789   # localhost만 허용
# OPENCLAW_GUARD_STRICT=1           # maximum 모드에서 자동 활성
# 게이트웨이 토큰: Keychain(OPENCLAW_GATEWAY_TOKEN) — openclaw.json 평문 금지
# 하드닝: python3 openclaw_guard.py --harden
# 감사:   python3 openclaw_guard.py --check
# npm update -g openclaw            # Claw Chain·RCE 패치 유지

# ── 선제적 경고 전달 방식 ──
# 매크로/고래/소셜/주가/지정가/리스크 등 '경고'를 음성 없이 화면(HUD)으로만 설명한다.
#   기본 ON(1). 0/false/off 로 두면 기존처럼 경고도 음성으로 브리핑한다.
#   (뉴스 브리핑·IR 요약·미디어 완료·주식 교차검증 후속 브리핑은 이 설정과 무관하게 음성 유지)
# JARVIS_WARN_SCREEN_ONLY=1

# ── 실시간 위험·자산 분석 알림 파이프라인 (risk_engine + fds) ──
# ALERT_PIPELINE_ENABLED=1           # 0/false/off → 파이프라인 비활성
# ALERT_PIPELINE_FDS=1                 # FDS 엔진 자동 부착 (행동 이상 탐지)
# ALERT_SECURE_ENDPOINT=               # 설정 시 OIDC+DeviceGuard SecureChannel로 외부 push
# ALERT_PUSH_SCOPE=alert.push          # SecureChannel 필수 OAuth 스코프
# ALERT_ALLOW_HOSTS=hooks.example.com  # 쉼표 구분 egress 호스트 화이트리스트
# ALERT_REQUIRE_DEVICE_BINDING=1       # cnf.jkt(PoP) 없는 토큰 거부

# ── 외부 미디어 스트리밍·오디오 파싱 (streamlink + ffmpeg) ──
# MEDIA_PIPELINE_ENABLED=1             # 0/false/off → 비활성
# MEDIA_MAX_REDIRECTS=10               # URL 사전검증 리다이렉트 상한 (net.py 와 동일)
# MEDIA_CAPTURE_TIMEOUT_SEC=600        # streamlink|ffmpeg 전체 타임아웃(초)
# MEDIA_CAPTURE_MAX_SECONDS=3600       # 라이브 캡처 최대 길이(초)
# MEDIA_PREFLIGHT_REDIRECTS=1          # HEAD 리다이렉트 체인 SSRF 검증
# MEDIA_STREAM_QUALITY=best            # streamlink 품질 (best / worst / audio_only 등)
# MEDIA_PREP_SAMPLE_RATE=48000         # master WAV 샘플레이트
# MEDIA_PREP_CHANNELS=2                # master WAV 채널

# ── Local Rule-Engine First (Gemini 비용 절감) ──
# LOCAL_RULE_ENGINE_ENABLED=1          # stock_monitor 로컬 1차 방어 ON
# LOCAL_RULE_REQUIRE_ANOMALY_FOR_GEMINI=1  # RSI/BB/변동률 특이점 없으면 Gemini 0회
# LOCAL_RULE_RSI_OVERSOLD=30
# LOCAL_RULE_RSI_OVERBOUGHT=70
# LOCAL_RULE_CHANGE_SPIKE_PCT=5        # ±5% 변동률 스파이크
# LOCAL_RULE_FETCH_PERIOD=3mo          # 로컬 지표용 yfinance 기간

# ── Cross-Validation 합의 캐시 (Gemini 2단계 절감) ──
# CV_CACHE_ENABLED=1                   # 샌드박스 market_snapshot.json 캐시 ON
# CV_CACHE_SNAPSHOT_FILE=market_snapshot.json
# CV_CACHE_MAX_AGE_SEC=3600            # On-Demand 캐시 재사용 TTL
# CV_CACHE_ON_DEMAND_GEMINI=1          # 사용자/도구 요청 시 compact_digest 만 Gemini
# CV_CACHE_BACKGROUND_NO_GEMINI=1      # news_analyzer 등 백그라운드 Gemini 0회
# CV_CACHE_CHANGE_SPIKE_PCT=5          # anomaly_flag 변동률 임계

# ── 주식 2단계 분석 (예비 답변 → 백그라운드 교차검증 + 멀티AI 정밀) ──
# JARVIS_STOCK_TWO_PHASE=1             # ON: 빠른 예비 답변 먼저 → 정밀 교차검증+AI 후속(jarvis_v2 시작 시 자동 ON)
# CV_FOLLOWUP_CORRECTION_TOL=0.01      # 예비가 대비 합의 편차 ≥ 이 값이면 '정정' 톤
# CV_FOLLOWUP_DEBOUNCE_SEC=8           # 동일 종목 후속 중복 방지(초)

# ── Hybrid Routing (Ollama ↔ Gemini 이원화) ──
# HYBRID_ROUTING_ENABLED=1             # 복잡도 기반 LLM 라우팅 ON
# HYBRID_DEFAULT_TIER=local            # 모호한 입력 기본: local|expert
# LOCAL_INTEL_OLLAMA_ENABLED=1         # 로컬 정성 분석 Ollama 사용
# LOCAL_INTEL_REPORT_FILE=local_analysis_report.json

# 네트워크 프로파일 (느린 WiFi 대응) — fast | normal | slow
# slow: 타임아웃을 늘려 매우 느린 회선에서도 끊기지 않게 함
NET_PROFILE=normal

# 캠퍼스 감시
CAMPUS_AGENT_ENABLED=true
CAMPUS_CHECK_INTERVAL=600

# Supply Chain Agent (Java — jarvis_v2.py 실행 시 자동 기동)
SUPPLY_CHAIN_URL=http://localhost:8080
SUPPLY_CHAIN_AUTO_START=true
# SUPPLY_CHAIN_STARTUP_TIMEOUT=120
# FIRESTORE_PROJECT_ID=your-gcp-project
# SUPPLY_CHAIN_STORAGE=memory
# 보안: 백엔드는 기본적으로 127.0.0.1 에만 바인딩됨(LAN 노출 차단).
#   외부 개방이 꼭 필요할 때만:  SUPPLY_CHAIN_BIND=0.0.0.0
# 공유 시크릿(X-API-Key) — 미설정 시 자동 기동이 무작위 키를 생성해 인증을 켭니다.
#   고정하려면 직접 지정:  SUPPLY_CHAIN_API_KEY=<랜덤 문자열>
# SUPPLY_CHAIN_BIND=127.0.0.1
# SUPPLY_CHAIN_API_KEY=

# ── 저사양 / 8GB RAM (Windows·Linux·Intel Mac 공통) ──
# LOW_MEM=1 시: 비전(얼굴·손·제스처) OFF, 640×480, 15 FPS, STT→OpenAI API 우선
# JARVIS_LOW_MEM=1
# JARVIS_MAIN_LOOP_FPS=15            # 메인 루프 상한 (LOW_MEM 기본 15)
# JARVIS_CAM_WIDTH=640
# JARVIS_CAM_HEIGHT=480
# JARVIS_VISION_ENABLED=0            # LOW_MEM 없이도 비전 강제 OFF
# JARVIS_DEVICE_LOCATION=1             # macOS CoreLocation — 실제 위치 (시스템 설정에서 JARVIS 허용 필요)
# USER_LOCATION_CITY=보정동          # CoreLocation/IP 실패 시에만 폴백
# USER_TZ_OFFSET=32400
#
# STT: local(로컬 Whisper) | api(OpenAI) | auto(LOW_MEM+API키→api)
# JARVIS_STT_BACKEND=auto
# JARVIS_STT_PROCESS=1               # 1=로컬 Whisper 별도 프로세스 (Apple Silicon 기본 ON)
#
# Whisper 로컬 사용 시 (STT_BACKEND=local)
# JARVIS_WHISPER_MODEL=small
# JARVIS_WAKE_WHISPER_MODEL=tiny
# JARVIS_WHISPER_COMPUTE=int8
# JARVIS_HAND_COMPLEXITY=0
# JARVIS_MAX_HISTORY=40

# ── Apple Silicon (M1~M5 MacBook Pro) 성능 최적화 ──
# pip install mlx-whisper 후 아래를 .env에 추가하면 Metal GPU STT + 부팅 스파이크 완화.
# JARVIS_WHISPER_BACKEND=auto        # Apple Silicon → 자동 MLX(Metal)
# JARVIS_STT_PROCESS=1               # Whisper 별도 프로세스 (GIL 회피, M시리즈 기본 ON)
# JARVIS_STAGGER_WORKERS=1           # 7개 백그라운드 워커 순차 기동
# JARVIS_WORKER_STAGGER_SEC=4        # 워커 간 간격(초)
# JARVIS_WHISPER_MLX_REPO=mlx-community/whisper-small-mlx-q4
#
# ── 귀 업그레이드: 웨이크워드 + 로컬 Whisper ──
# "자비스야" → openWakeWord(hey jarvis) + MLX Whisper fuzzy 확인 (hybrid)
# JARVIS_WAKE_ENGINE=hybrid          # off | whisper | openwakeword | hybrid
# JARVIS_OWW_THRESHOLD=0.55          # openWakeWord 점수 임계
# JARVIS_OWW_MODELS=hey_jarvis       # pip install openwakeword (모델 자동 다운로드)
# WAKE_WORDS=자비스야,자비스,jarvis,hey jarvis
# JARVIS_WAKE_WHISPER_MODEL=base     # 웨이크 확인용 경량 모델
# JARVIS_WHISPER_MODEL=large-v3      # 본 STT (M5 Pro 실시간)
#
# ── 손짓 (음성 모드, G키 OFF) ──
# JARVIS_VOICE_GESTURES=1            # ✋일시정지 ✊음소거 👍확인
#
# ── SQLite 메모리 (아까 그거 / 앱 사용 패턴) ──
# JARVIS_MEMORY_ENABLED=1
# JARVIS_MEMORY_DB=data/jarvis_memory.db
# JARVIS_MEMORY_TURNS=6              # system prompt에 넣을 최근 턴
#
# Ollama 오프라인 LLM (Metal GPU 자동):
#   brew install ollama && ollama pull qwen2.5:7b-instruct-q4_K_M
#   ollama pull llama3.2:3b          # 더 가벼운 대안
