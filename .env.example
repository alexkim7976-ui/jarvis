# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  JARVIS .env 템플릿
#  이 파일을 복사해 .env로 만들고 실제 키를 입력하세요.
#  cp .env.example .env && chmod 600 .env
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_here

# Gemini 하이브리드 모델 이원화
#  - FLASH: 음성 대화/명령 텍스트 분석 등 경량·고빈도 작업 (저비용·고속)
#  - PRO  : 차트 이미지 등 멀티모달 비전·복합 추론 (고정밀·고비용)
#  ※ 모델 ID는 현재 Gemini API에서 유효한지 반드시 확인 후 사용 (잘못되면 404)
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
# Gemini 호출당 전달할 최근 대화 메시지 수 (토큰 절약용 컨텍스트 윈도우, 기본 10)
GEMINI_CONTEXT_TURNS=10

# TTS (Fish Audio)
FISH_AUDIO_API_KEY=your_fish_audio_key_here
FISH_VOICE_ID=your_voice_id_here

# 검색/날씨
TAVILY_API_KEY=your_tavily_key_here
OPENWEATHER_API_KEY=your_openweather_key_here

# GitHub 모니터
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# ── 텔레그램 알림 브리지 ──
#  외출 중(얼굴 미검출 자동 AWAY) 긴급 뉴스·지정가·매크로 경보를 폰/아이패드로 푸시.
#  1) 텔레그램에서 @BotFather 검색 → /newbot → 봇 토큰(TELEGRAM_BOT_TOKEN) 발급
#  2) 만든 봇과 대화 시작(/start) 후, 아래 주소로 chat_id 확인:
#     https://api.telegram.org/bot<봇토큰>/getUpdates  → result[].message.chat.id
#  ※ 별도 패키지 불필요 — 내장 requests 로 Bot API 직접 호출.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# 테스트용: 1 로 두면 자리에 있어도(AWAY 아니어도) 항상 푸시 (검증 후 0 권장)
TELEGRAM_ALWAYS_PUSH=0

# Ollama 오프라인 폴백 (Apple Silicon: Ollama가 Metal GPU 자동 사용)
# M시리즈 권장: 7B급 Q4 양자화 모델 (13B+ 비권장 — RAM·레이턴시↑)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=4096          # 컨텍스트 윈도우 상한 (토큰 누적 방지)
# OLLAMA_NUM_GPU=-1            # -1=Metal GPU 전 레이어 (기본), 0=CPU만

# Gemini Context Caching (입력 토큰 최대 ~80% 절감)
# GEMINI_CACHE_ENABLED=1              캐싱 ON (기본)
# GEMINI_CACHE_TTL_SEC=7200           TTL 2시간
# GEMINI_CACHE_REFRESH_BEFORE=600     만료 10분 전 자동 연장
# GEMINI_CACHE_CONTEXT_FILES=security.py,file_manager.py,stock_quant.py,...
# GEMINI_CACHE_MAX_FILE_KB=256        파일당 최대 KB
# GEMINI_CONTEXT_TURNS=10      # LLM 호출당 최근 N개 메시지만 전달
# JARVIS_MAX_HISTORY=40        # 메모리 유지 상한
# JARVIS_HISTORY_SUMMARIZE=1   # 오래된 대화 Gemini Flash로 압축 요약
# JARVIS_SUMMARIZE_CHARS=12000 # 이 문자 수 초과 시 요약 트리거

# ── 실시간 위험·자산 분석 알림 파이프라인 (risk_engine + fds) ──
# ALERT_PIPELINE_ENABLED=1           # 0/false/off → 파이프라인 비활성
# ALERT_PIPELINE_FDS=1                 # FDS 엔진 자동 부착 (행동 이상 탐지)
# ALERT_SECURE_ENDPOINT=               # 설정 시 OIDC+DeviceGuard SecureChannel로 외부 push
# ALERT_PUSH_SCOPE=alert.push          # SecureChannel 필수 OAuth 스코프
# ALERT_ALLOW_HOSTS=hooks.example.com  # 쉼표 구분 egress 호스트 화이트리스트
# ALERT_REQUIRE_DEVICE_BINDING=1       # cnf.jkt(PoP) 없는 토큰 거부

# ── 외부 미디어 스트리밍·오디오 파싱 (streamlink + ffmpeg) ──
# MEDIA_PIPELINE_ENABLED=1             # 0/false/off → 비활성
# MEDIA_MAX_REDIRECTS=10               # URL 사전검증 리다이렉트 상한 (net.py 와 동일)
# MEDIA_CAPTURE_TIMEOUT_SEC=600        # streamlink|ffmpeg 전체 타임아웃(초)
# MEDIA_CAPTURE_MAX_SECONDS=3600       # 라이브 캡처 최대 길이(초)
# MEDIA_PREFLIGHT_REDIRECTS=1          # HEAD 리다이렉트 체인 SSRF 검증
# MEDIA_STREAM_QUALITY=best            # streamlink 품질 (best / worst / audio_only 등)
# MEDIA_PREP_SAMPLE_RATE=48000         # master WAV 샘플레이트
# MEDIA_PREP_CHANNELS=2                # master WAV 채널

# 네트워크 프로파일 (느린 WiFi 대응) — fast | normal | slow
# slow: 타임아웃을 늘려 매우 느린 회선에서도 끊기지 않게 함
NET_PROFILE=normal

# 캠퍼스 감시
CAMPUS_AGENT_ENABLED=true
CAMPUS_CHECK_INTERVAL=600

# Supply Chain Agent (Java — jarvis_v2.py 실행 시 자동 기동)
SUPPLY_CHAIN_URL=http://localhost:8080
SUPPLY_CHAIN_AUTO_START=true
# SUPPLY_CHAIN_STARTUP_TIMEOUT=120
# FIRESTORE_PROJECT_ID=your-gcp-project
# SUPPLY_CHAIN_STORAGE=memory
# 보안: 백엔드는 기본적으로 127.0.0.1 에만 바인딩됨(LAN 노출 차단).
#   외부 개방이 꼭 필요할 때만:  SUPPLY_CHAIN_BIND=0.0.0.0
# 공유 시크릿(X-API-Key) — 미설정 시 자동 기동이 무작위 키를 생성해 인증을 켭니다.
#   고정하려면 직접 지정:  SUPPLY_CHAIN_API_KEY=<랜덤 문자열>
# SUPPLY_CHAIN_BIND=127.0.0.1
# SUPPLY_CHAIN_API_KEY=

# ── 저사양 / 8GB RAM (Windows·Linux·Intel Mac 공통) ──
# LOW_MEM=1 시: 비전(얼굴·손·제스처) OFF, 640×480, 15 FPS, STT→OpenAI API 우선
# JARVIS_LOW_MEM=1
# JARVIS_MAIN_LOOP_FPS=15            # 메인 루프 상한 (LOW_MEM 기본 15)
# JARVIS_CAM_WIDTH=640
# JARVIS_CAM_HEIGHT=480
# JARVIS_VISION_ENABLED=0            # LOW_MEM 없이도 비전 강제 OFF
#
# STT: local(로컬 Whisper) | api(OpenAI) | auto(LOW_MEM+API키→api)
# JARVIS_STT_BACKEND=auto
# JARVIS_STT_PROCESS=1               # 1=로컬 Whisper 별도 프로세스 (Apple Silicon 기본 ON)
#
# Whisper 로컬 사용 시 (STT_BACKEND=local)
# JARVIS_WHISPER_MODEL=small
# JARVIS_WAKE_WHISPER_MODEL=tiny
# JARVIS_WHISPER_COMPUTE=int8
# JARVIS_HAND_COMPLEXITY=0
# JARVIS_MAX_HISTORY=40

# ── Apple Silicon (M1~M5 MacBook Pro) 성능 최적화 ──
# pip install mlx-whisper 후 아래를 .env에 추가하면 Metal GPU STT + 부팅 스파이크 완화.
# JARVIS_WHISPER_BACKEND=auto        # Apple Silicon → 자동 MLX(Metal)
# JARVIS_STT_PROCESS=1               # Whisper 별도 프로세스 (GIL 회피, M시리즈 기본 ON)
# JARVIS_STAGGER_WORKERS=1           # 7개 백그라운드 워커 순차 기동
# JARVIS_WORKER_STAGGER_SEC=4        # 워커 간 간격(초)
# JARVIS_WHISPER_MLX_REPO=mlx-community/whisper-small-mlx-q4
#
# Ollama 오프라인 LLM (Metal GPU 자동):
#   brew install ollama && ollama pull qwen2.5:7b-instruct-q4_K_M
#   ollama pull llama3.2:3b          # 더 가벼운 대안
